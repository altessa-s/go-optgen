// Option is a functional option for configuring options.
type Option func(o *options)

// SetClientName selects the client name.
func SetClientName[T interface{ string | *string }](v T) Option {
	return func(o *options) {
		var value string
		switch t := any(v).(type) {
		case string:
			value = t
		case *string:
			if t == nil {
